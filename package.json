{
  "name": "crop-advisory-assistant",
  "version": "1.0.0",
  "description": "Production-Ready AI-Powered Agriculture Crop Advisory Assistant",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"green,blue\" \"node server/index.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "db:migrate": "node server/db/migrate.js",
    "db:seed": "node server/db/seed.js"
  },
  "keywords": [
    "agriculture",
    "crop-advisory",
    "gemini-ai",
    "farmer-assistant",
    "precision-farming"
  ],
  "author": "Google DeepMind Principal Engineer",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.27.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
